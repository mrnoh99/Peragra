<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- A plain "TRUEPREDICATE" string here (what this used to be)
			     works fine for a local Xcode Run, but App Store Connect's
			     distribution validation rejects it outright ("Invalid
			     Info.plist value ... NSExtensionActivationRule ... is
			     invalid") — it wants the dictionary form instead. This
			     matches an item providing a URL (public.url — any app's
			     share, not just Safari's) or plain text, with a max count
			     of 1 each, which covers every map app this extension is
			     meant for (Google Maps, Naver Map, Kakao Map, ...): all of
			     them hand off either a link, some text, or both. Content
			     this app still can't use (no URL/text/title found once
			     actually handed to the extension) stays a no-op — see
			     ShareViewController.handleSharedItem. -->
			<key>NSExtensionActivationRule</key>
			<dict>
				<key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
				<integer>1</integer>
				<key>NSExtensionActivationSupportsText</key>
				<true/>
			</dict>
		</dict>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
	</dict>
</dict>
</plist>
